# Tattoo House: local environment. Copy to .env and fill in. Never commit .env.
#
# Supabase: Project Settings -> API.
# The anon / publishable key is public by design (data is protected by RLS),
# but we still keep it out of the repo: config.js is generated from this file
# locally (python3 tools/make_config.py) and from GitHub Secrets on deploy.
# Never put the service_role / secret key here or anywhere in this project.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Test admin account for e2e checks (a separate Supabase Auth user, not the owner)
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
